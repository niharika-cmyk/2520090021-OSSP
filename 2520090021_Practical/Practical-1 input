#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main()
{
    int src, dest;
    char buffer[100];
    int n;

    src = open("sample.txt", O_RDONLY);
    dest = open("copy.txt", O_WRONLY | O_CREAT | O_TRUNC, 0644);

    if (src == -1 || dest == -1)
    {
        printf("Error opening file\n");
        return 1;
    }

    while ((n = read(src, buffer, sizeof(buffer))) > 0)
    {
        write(dest, buffer, n);
    }

    close(src);
    close(dest);

    printf("File copied successfully.\n");

    return 0;
}
