// server// 
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <fcntl.h>
#include <unistd.h>

#define SIZE 100

int main() {
    int read_fd, write_fd;
    char message[SIZE];
    char response[SIZE];

    printf("Server started...\n");

    // Open FIFO for reading
    read_fd = open("client_to_server", O_RDONLY);

    // Open FIFO for writing
    write_fd = open("server_to_client", O_WRONLY);

    while (1) {
        memset(message, 0, SIZE);

        // Read message from client
        int n = read(read_fd, message, SIZE - 1);

        if (n <= 0) {
            continue;
        }

        message[n] = '\0';

        printf("Client says: %s\n", message);

        // Exit condition
        if (strcmp(message, "exit") == 0) {
            strcpy(response, "Server shutting down.");
            write(write_fd, response, strlen(response) + 1);
            break;
        }

        // Process the message
        snprintf(response, SIZE, "Server processed: %.70s", message);
        

        // Send response
        write(write_fd, response, strlen(response) + 1);

        printf("Response sent: %s\n", response);
    }

    close(read_fd);
    close(write_fd);

    unlink("client_to_server");
    unlink("server_to_client");

    printf("Server stopped.\n");

    return 0;
}

//server //
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <fcntl.h>
#include <unistd.h>

#define SIZE 100

int main() {
    int write_fd, read_fd;
    char message[SIZE];
    char response[SIZE];

    // Open FIFO for writing
    write_fd = open("client_to_server", O_WRONLY);

    // Open FIFO for reading
    read_fd = open("server_to_client", O_RDONLY);

    while (1) {

        printf("Enter message: ");
        fgets(message, SIZE, stdin);

        // Remove newline
        message[strcspn(message, "\n")] = '\0';

        // Send message
        write(write_fd, message, strlen(message) + 1);

        // Receive response
        memset(response, 0, SIZE);

        int n = read(read_fd, response, SIZE - 1);

        if (n > 0) {
            response[n] = '\0';
            printf("Server response: %s\n", response);
        }

        if (strcmp(message, "exit") == 0) {
            break;
        }
    }

    close(write_fd);
    close(read_fd);

    return 0;
}
